# 本地开发默认值（Vite 始终加载 .env，再叠加 .env.[mode]）

# 后端 API 基地址（必须包含 /app-api）
VITE_APP_API_URL=http://localhost:48081/app-api

# 静态资源（图片）域名前缀
VITE_APP_RESOURCES_URL=https://h5.yixiang.co/static

# 微信小程序 / 公众号 AppID，请替换为你自己的
VITE_WX_APP_ID=wxdbdbc123c8c30b45

# 本地 Mock 开关：true 时无需后端即可浏览验收
VITE_USE_MOCK=false
