# 复制为 .env（或 .env.production）后按需修改
# 所有 VITE_ 前缀变量会被 Vite 注入到 import.meta.env

# 后端 API 基地址（必须包含 /app-api）。本地后端默认 48081 端口
VITE_APP_API_URL=http://localhost:48081/app-api

# 静态资源（图片）域名前缀
VITE_APP_RESOURCES_URL=https://h5.yixiang.co/static

# 微信小程序 / 公众号 AppID，请替换为你自己的账号
VITE_WX_APP_ID=wxdbdbc123c8c30b45

# 本地 Mock 开关：true 时无需后端即可浏览验收（仅用于演示/UI 验收）
VITE_USE_MOCK=false
